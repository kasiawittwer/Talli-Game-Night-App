# Optional: point the app at the local Express helper in /server (see server/server.js).
# Used for (1) OpenAI proxy without putting the key in the client bundle, and
# (2) fetching gamerules.com HTML on web (avoids browser CORS).
#
# Copy to `.env` in this folder — Expo loads EXPO_PUBLIC_* at build/start.
# On Vercel: Project → Settings → Environment Variables (set for Production).
EXPO_PUBLIC_GAME_ASSISTANT_API_URL=http://localhost:3000

# Only if you are not using the server proxy; prefer keeping the key on the server instead.
# EXPO_PUBLIC_OPENAI_API_KEY=
